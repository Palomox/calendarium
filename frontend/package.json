    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@ory/client": "^1.22.66",
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "twemoji": "^14.0.2",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@vue/devtools-api": "^8.2.1",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.3",
    "vite": "^8.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue-tsc": "^3.3.14"
